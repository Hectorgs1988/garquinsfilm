# Valores solo para desarrollo local. No reutilizar fuera de esta máquina.
NODE_ENV=development
POSTGRES_DB=garquinsfilm
POSTGRES_USER=garquinsfilm
POSTGRES_PASSWORD=garquinsfilm_local_only
POSTGRES_PORT=5433
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
DATABASE_URL=postgresql://garquinsfilm:garquinsfilm_local_only@127.0.0.1:5433/garquinsfilm?schema=public
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WEB_APP_URL=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GarquinsFilm <no-reply@garquinsfilm.local>"
# Exact local Compose database destination permitted to the administrative CLI.
LOCAL_AUTH_ALLOWED_DATABASES=garquinsfilm@127.0.0.1:5433/garquinsfilm?schema=public
