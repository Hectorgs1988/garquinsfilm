generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  admin
  user
}

enum InvitationStatus {
  PENDING_DELIVERY
  ACTIVE
  DELIVERY_FAILED
  REVOKED
  CONSUMED
}

enum MediaSource {
  tmdb
}

enum MediaType {
  movie
  tv
}

enum LibraryEntryStatus {
  PENDING
  WATCHING
  COMPLETED
  ABANDONED
}

model User {
  id                 String         @id
  name               String
  email              String
  emailVerified      Boolean        @default(false)
  image              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  role               GlobalRole     @default(user)
  sessions           Session[]
  accounts           Account[]
  invitationsCreated Invitation[]   @relation("InvitationCreator")
  invitationAccepted Invitation?    @relation("InvitationConsumer")
  auditEvents        AuditEvent[]   @relation("AuditActor")
  libraryEntries     LibraryEntry[]

  @@unique([email])
  @@map("user")
}

model Media {
  id             String         @id @default(cuid())
  source         MediaSource
  type           MediaType
  tmdbId         Int
  libraryEntries LibraryEntry[]

  @@unique([source, type, tmdbId])
  @@map("media")
}

model LibraryEntry {
  id          String             @id @default(cuid())
  userId      String
  mediaId     String
  status      LibraryEntryStatus @default(PENDING)
  isFavorite  Boolean            @default(false)
  addedAt     DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  completedAt DateTime?
  rating      Rating?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media              @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([userId, mediaId])
  @@index([userId, addedAt])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, isFavorite])
  @@map("library_entry")
}

model Rating {
  id               String       @id @default(cuid())
  libraryEntryId   String       @unique
  scoreTenths      Int?
  review           String?
  containsSpoilers Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  libraryEntry     LibraryEntry @relation(fields: [libraryEntryId], references: [id], onDelete: Cascade)

  @@map("rating")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Invitation {
  id              String           @id @default(cuid())
  email           String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING_DELIVERY)
  createdAt       DateTime         @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  consumedUserId  String?          @unique
  createdBy       User             @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  consumedUser    User?            @relation("InvitationConsumer", fields: [consumedUserId], references: [id], onDelete: SetNull)

  @@index([email, expiresAt])
  @@index([createdByUserId, createdAt])
  @@map("invitation")
}

model AuditEvent {
  id          String   @id @default(cuid())
  action      String
  actorUserId String?
  targetId    String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_event")
}
