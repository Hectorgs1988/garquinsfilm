{
  "name": "@garquinsfilm/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm prisma:generate && tsx watch src/server.ts",
    "build": "pnpm prisma:generate && tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && vitest run",
    "test:integration": "pnpm prisma:generate && RUN_AUTH_INTEGRATION_TESTS=1 vitest run src/auth/auth.integration.test.ts",
    "auth:schema:generate": "auth generate --config src/auth/auth.ts --adapter prisma --dialect postgresql --output prisma/schema.prisma --yes",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.11",
    "@fastify/cors": "11.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.11",
    "dotenv": "18.0.8",
    "fastify": "^5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "auth": "1.7.11",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
