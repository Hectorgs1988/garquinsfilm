{
  "name": "@garquinsfilm/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm prisma:generate && tsx watch src/server.ts",
    "build": "pnpm prisma:generate && tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && vitest run",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "fastify": "^5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
