              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cache-Control private, no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store'));",
                  "const p = pm.response.json();",
                  "pm.test('Forma del perfil', () => { pm.expect(p).to.have.keys(['name', 'bio', 'avatar']); pm.expect(p.avatar).to.eql({ kind: 'initials' }); });",
                  "pm.test('No expone el email', () => pm.expect(pm.response.text()).to.not.include('@'));",
                  "pm.collectionVariables.set('originalName', p.name);"
                ]
              }
            }
