                "exec": [
                  "pm.test('Estado 201 o 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "function rememberEntry(code, varName, type, tmdbId) {",
                  "  if (code === 201) { pm.collectionVariables.set(varName, pm.response.json().id); return; }",
                  "  // 409: ya estaba en la biblioteca; \"Listar biblioteca\" recupera el id.",
                  "  pm.collectionVariables.unset(varName);",
                  "}",
                  "rememberEntry(pm.response.code, 'movieEntryId');"
                ]
              }
            }
