                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cache-Control private, no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('private, no-store'));",
                  "const body = pm.response.json();",
                  "const items = body.results ?? body.items ?? [];",
                  "const find = (type, tmdbId) => items.find((e) => e.type === type && String(e.tmdbId) === String(tmdbId));",
                  "if (!pm.collectionVariables.get('movieEntryId')) {",
                  "  const m = find('movie', pm.variables.get('movieTmdbId'));",
                  "  if (m) pm.collectionVariables.set('movieEntryId', m.id);",
                  "}",
                  "if (!pm.collectionVariables.get('tvEntryId')) {",
                  "  const t = find('tv', pm.variables.get('tvTmdbId'));",
                  "  if (t) pm.collectionVariables.set('tvEntryId', t.id);",
                  "}",
                  "pm.test('Ids de prueba localizados', () => {",
                  "  pm.expect(pm.collectionVariables.get('movieEntryId')).to.be.ok;",
                  "  pm.expect(pm.collectionVariables.get('tvEntryId')).to.be.ok;",
